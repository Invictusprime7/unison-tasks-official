{
  "servers": {
    "supabase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref",
        "nfrdomdvyrbwuokathtw"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${input:supabaseAccessToken}"
      }
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${input:twentyFirstApiKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "supabaseAccessToken",
      "type": "promptString",
      "description": "Supabase personal access token for the UNISON-TASKS MCP server",
      "password": true
    },
    {
      "id": "twentyFirstApiKey",
      "type": "promptString",
      "description": "21st.dev API key",
      "password": true
    }
  ]
}
